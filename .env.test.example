# Copy to .env.local (or export in CI) before running `pnpm test:e2e`.
# Playwright drives a real `next dev` server (see playwright.config.ts), so
# every var the app itself needs at runtime is required here too — this file
# only calls out what's specific to running the E2E suite.

# A real (or `pnpm exec prisma dev`) Postgres — E2E specs sign up real users
# and create real rows, unlike the Vitest suite, which never touches a
# database at all.
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"
DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres"

SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# `next dev`'s NODE_ENV is "development", not "test", so mock mode has to be
# requested explicitly here (see src/lib/higgsfield/client.ts's isMockMode()).
HIGGSFIELD_MODE="mock"

# Optional. Unset: agent-chat.spec.ts and campaign-export.spec.ts skip
# themselves with a clear reason — there's no offline mock for the model
# itself, only for Higgsfield. Set to a real key to exercise those flows too.
# ANTHROPIC_API_KEY="replace-with-anthropic-api-key"
