# Copy this file to .env and fill in real values. Nothing here is a secret.

# --- Database (Supabase Postgres) ---
# Pooled connection (PgBouncer, port 6543) — used by the running app.
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used only for migrations.
DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# --- Supabase Storage ---
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

# --- NextAuth (Auth.js v5) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"

# SMTP transport used for magic-link email + workspace invites.
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="Ayvid Studio <no-reply@ayvidmedia.com>"

# --- Agent model ---
ANTHROPIC_API_KEY="replace-with-anthropic-api-key"

# --- Higgsfield (server-side only, never expose to client) ---
HIGGSFIELD_API_KEY_ID="replace-with-higgsfield-key-id"
HIGGSFIELD_API_KEY_SECRET="replace-with-higgsfield-key-secret"
# "mock" | "live" — mock mode is used automatically in tests/CI regardless of this value.
HIGGSFIELD_MODE="mock"

# --- Stripe (Milestone 7) ---
STRIPE_SECRET_KEY="replace-with-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="replace-with-stripe-webhook-secret"
